#!name=龙湖接口诊断与凭据捕获
#!desc=原样记录龙湖请求和响应，同时捕获 APP 与小程序凭据；手机端不设定时签到
#!system=ios
# 本模块用于手机端诊断，实际定时签到由服务器执行。
# 登录、进入签到页并操作验证后，导出 PacketTunnel 日志。
# 请求头、Cookie、Token 和文本正文原样记录；脚本不上传日志。

[MITM]
hostname = %APPEND% longfor.com,*.longfor.com,longhu.net,*.longhu.net

[Script]
龙湖请求诊断及凭据捕获 = type=http-request,pattern=^https?:\/\/(?:[a-zA-Z0-9-]+\.)*(?:longfor\.com|longhu\.net)(?::\d+)?(?:\/|$),requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/Ruthguo/Auxiliary@v1.3.3/Script/longfor/longfor-checkin.js

龙湖响应诊断 = type=http-response,pattern=^https?:\/\/(?:[a-zA-Z0-9-]+\.)*(?:longfor\.com|longhu\.net)(?::\d+)?(?:\/|$),requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/Ruthguo/Auxiliary@v1.3.3/Script/longfor/longfor-checkin.js
