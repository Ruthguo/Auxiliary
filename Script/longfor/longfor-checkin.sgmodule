#!name=龙湖接口诊断与凭据捕获
#!desc=仅记录龙湖业务网关请求和响应，捕获 APP 与小程序凭据；不解密验证码服务
#!system=ios
# 本模块用于手机端诊断，实际定时签到由服务器执行。
# 必须先停用 v1.3.3；它的广域 MITM 规则不能与本版同时启用。
# 登录、进入签到页并操作验证后，导出 PacketTunnel 日志。
# 请求头、Cookie、Token 和文本正文原样记录；脚本不上传日志。

[MITM]
hostname = %APPEND% gw2c-hw-open.longfor.com

[Script]
龙湖请求诊断及凭据捕获 = type=http-request,pattern=^https?:\/\/gw2c-hw-open\.longfor\.com(?::\d+)?(?:\/|$),requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/Ruthguo/Auxiliary@v1.3.4/Script/longfor/longfor-checkin.js

龙湖响应诊断 = type=http-response,pattern=^https?:\/\/gw2c-hw-open\.longfor\.com(?::\d+)?(?:\/|$),requires-body=1,max-size=1048576,script-path=https://cdn.jsdelivr.net/gh/Ruthguo/Auxiliary@v1.3.4/Script/longfor/longfor-checkin.js
